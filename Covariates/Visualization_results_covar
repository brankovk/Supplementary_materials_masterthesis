%% After creating the function 'plot_partialcorr.m' we can begin with the figures
%% Definitions
T=T_nct
covars = [T.Age T.Gender T.in_scanner_motion];

%% H1: 0-back -> 2-back
plot_partialcorr(...
    T.E0_2,...
    T.PSMT,...
    covars,...
    'Residualized 0→2 Back Energy',...
    'Residualized PSMT',...
    'H1_E0_2_PSMT.pdf');

%% H2: 2-back → 0-back energy
plot_partialcorr(...
    T.E2_0,...
    T.PSMT,...
    covars,...
    'Residualized 2→0 Back Energy',...
    'Residualized PSMT',...
    'H2_E2_0_PSMT.pdf');

%% H3: S2 and episodic memory
plot_partialcorr(...
    T.S2,...
    T.PSMT,...
    covars,...
    'Residualized S2',...
    'Residualized PSMT',...
    'H3_S2_PSMT.pdf');

%% H5: ∆E and episodic memory
plot_partialcorr(...
    T.dE,...
    T.PSMT,...
    covars,...
    'Residualized ΔE',...
    'Residualized PSMT',...
    'H5_dE_PSMT.pdf');

%% H6: ∆S and episodic memory
plot_partialcorr(...
    T.dS,...
    T.PSMT,...
    covars,...
    'Residualized ΔS',...
    'Residualized PSMT',...
    'H6_dS_PSMT.pdf');

%% H7: ∆S and ∆E
plot_partialcorr(...
    T.dS,...
    T.dE,...
    covars,...
    'Residualized ΔS',...
    'Residualized ΔE',...
    'H7_dS_dE.pdf');
