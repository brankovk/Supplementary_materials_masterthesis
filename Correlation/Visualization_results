%% H1: 0-back -> 2-back

figure('Color','w');

scatter(T.E0_2,T.PSMT,...
    60,...
    'filled',...
    'MarkerFaceAlpha',0.7,...
    'MarkerFaceColor',[0 114 178]/255);

hold on

mdl = fitlm(T.E0_2,T.PSMT);

xfit = linspace(min(T.E0_2),max(T.E0_2),100)';
[yfit,yCI] = predict(mdl,xfit);

% Confidence interval
fill([xfit;flipud(xfit)],...
     [yCI(:,1);flipud(yCI(:,2))],...
     [0.85 0.85 0.85],...
     'EdgeColor','none',...
     'FaceAlpha',0.4);

% Regression line
plot(xfit,yfit,'k','LineWidth',2);

% Correlation statistics
[r,p] = corr(T.E0_2,T.PSMT,'Rows','complete');

text(0.05,0.95,...
    sprintf('r = %.2f\np = %.3f',r,p),...
    'Units','normalized',...
    'FontSize',12,...
    'VerticalAlignment','top');

xlabel('Control Energy (0-back \rightarrow 2-back)');
ylabel('Age-adjusted Picture Sequence Memory Test');

set(gca,...
    'FontSize',14,...
    'FontName','Arial',...
    'LineWidth',1.2,...
    'Box','off');

exportgraphics(gcf,...
    'H1_EnergyMemory.pdf',...
    'ContentType','vector');

