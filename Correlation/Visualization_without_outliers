 %% H2: 2-back -> 0-back

figure('Color','w');

scatter(E2_0_clean,PSMT_clean_H2,...
    60,...
    'filled',...
    'MarkerFaceAlpha',0.7,...
    'MarkerFaceColor',[0 114 178]/255);

hold on

mdl = fitlm(E2_0_clean,PSMT_clean_H2);

xfit = linspace(min(E2_0_clean),max(E2_0_clean),100)';
[yfit,yCI] = predict(mdl,xfit);

% Confidence interval
fill([xfit;flipud(xfit)],...
     [yCI(:,1);flipud(yCI(:,2))],...
     [0.85 0.85 0.85],...
     'EdgeColor','none',...
     'FaceAlpha',0.4);

% Regression line
plot(xfit,yfit,'k','LineWidth',2);

% Correlation statistics
[r,p] = corr(E2_0_clean,PSMT_clean_H2,'Rows','complete');

text(0.05,0.95,...
    sprintf('r = %.2f\np = %.3f',r,p),...
    'Units','normalized',...
    'FontSize',12,...
    'VerticalAlignment','top');

xlabel('Control Energy (2-back \rightarrow 0-back)');
ylabel('Age-adjusted Picture Sequence Memory Test');


set(gca,...
    'FontSize',14,...
    'FontName','Arial',...
    'LineWidth',1.2,...
    'Box','off');

exportgraphics(gcf,...
    'H1_EnergyMemory.pdf',...
    'ContentType','vector');

