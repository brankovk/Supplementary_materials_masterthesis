%% For H1 & H2
% This section extracts variables from table T and removes outliers 
% using the standard 3 scaled MAD method across the entire dataset.

% Extract columns from your table T
E0_2 = T.E0_2;
E2_0 = T.E2_0;
PSMT = T.PSMT;

% Identify rows that contain outliers (1 = outlier, 0 = normal data)
outliers_H1 = isoutlier(E0_2, 'median', 'ThresholdFactor', 3) | isoutlier(PSMT, 'median', 'ThresholdFactor', 3);
outliers_H2 = isoutlier(E2_0, 'median', 'ThresholdFactor', 3) | isoutlier(PSMT, 'median', 'ThresholdFactor', 3);

% Create clean data arrays by removing the outlier rows
E0_2_clean = E0_2(~outliers_H1);
PSMT_clean_H1 = PSMT(~outliers_H1);

E2_0_clean = E2_0(~outliers_H2);
PSMT_clean_H2 = PSMT(~outliers_H2);

% Print the number of outliers removed to the command window
fprintf('Hypothesis 1: Removed %d outliers.\n', sum(outliers_H1));
fprintf('Hypothesis 2: Removed %d outliers.\n', sum(outliers_H2));

% 2. RUN NEW CORRELATIONS WITH CLEAN DATA
% This section runs the new Pearson correlations without the table outliers.

disp('--- New Results for Hypothesis 1 (Clean Data) ---');
[R_H1, P_H1] = corrcoef(E0_2_clean, PSMT_clean_H1);
fprintf('New r = %.3f, New p = %.3f\n\n', R_H1(1,2), P_H1(1,2));

disp('--- New Results for Hypothesis 2 (Clean Data) ---');
[R_H2, P_H2] = corrcoef(E2_0_clean, PSMT_clean_H2);
fprintf('New r = %.3f, New p = %.3f\n\n', R_H2(1,2), P_H2(1,2));

%3. GET THE PSMT RESULTS OF THE OUTLIERS

